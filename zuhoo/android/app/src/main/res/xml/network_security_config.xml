<?xml version="1.0" encoding="utf-8"?>
<!--
  Development only.

  The BusinessOS backend runs on plain HTTP at :8085 during development, and
  Android has blocked cleartext by default since API 28. Rather than reopening
  cleartext for the whole app with usesCleartextTraffic="true", this permits it
  for exactly two hosts: 10.0.2.2 (the emulator's alias for the host machine's
  loopback) and localhost.

  Anything else — including a staging or production backend — must be HTTPS,
  which is what keeps this file from quietly becoming a permanent hole. If you
  run the backend on a LAN IP for a physical device, add that address here
  temporarily; do not replace this with a blanket cleartext permission.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
